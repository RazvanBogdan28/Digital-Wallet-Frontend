# Leave empty to call the API on the same origin (/api/...).
# That works out of the box in dev (Vite proxy) and on Vercel/Netlify (rewrites).
# Set a full URL only if you host the frontend somewhere without rewrites;
# in that case the backend must allow your frontend origin via CORS (see README).
VITE_API_URL=

# Dev proxy target (defaults to the production Railway deployment)
VITE_PROXY_TARGET=https://digital-wallet-api-production-2f16.up.railway.app
